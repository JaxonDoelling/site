---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 300 300"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <g transform="rotate(-38 150 150)">
    <!-- blade: curved single edge tapering to an angled kissaki tip -->
    <path
      d="M 146 50
         L 158 68
         C 164 110 164 160 160 205
         L 134 205
         C 130 160 130 110 136 68
         Z"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"
    />
    <!-- tsuba (guard) -->
    <circle cx="147" cy="211" r="13" stroke="currentColor" stroke-width="1.5" />
    <!-- tsuka (handle) -->
    <rect x="136" y="224" width="22" height="50" rx="4" stroke="currentColor" stroke-width="1.5" />
    <!-- ito wrap -->
    <line x1="136" y1="232" x2="158" y2="237" stroke="currentColor" stroke-width="1" />
    <line x1="136" y1="240" x2="158" y2="245" stroke="currentColor" stroke-width="1" />
    <line x1="136" y1="248" x2="158" y2="253" stroke="currentColor" stroke-width="1" />
    <line x1="136" y1="256" x2="158" y2="261" stroke="currentColor" stroke-width="1" />
    <line x1="136" y1="264" x2="158" y2="269" stroke="currentColor" stroke-width="1" />
    <!-- kashira (pommel) -->
    <rect x="136" y="274" width="22" height="10" rx="4" stroke="currentColor" stroke-width="1.5" />
  </g>
</svg>
