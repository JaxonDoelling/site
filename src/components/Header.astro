---
import OctopusMark from './OctopusMark.astro';

const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/writing', label: 'Writing' },
  { href: '/about', label: 'About' },
];

const current = Astro.url.pathname;
---

<header class="header">
  <a href="/" class="brand">
    <OctopusMark size={22} />
    <span>Jaxon Doelling</span>
  </a>
  <nav class="nav">
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={['nav-link', { active: current.startsWith(link.href) }]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .brand :global(svg) {
    color: var(--color-text-secondary);
  }

  .nav {
    display: flex;
    gap: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .nav-link {
    color: var(--color-text-secondary);
    transition: color 0.15s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .header {
      padding: 1rem 1.25rem;
    }
    .nav {
      gap: 1rem;
    }
  }
</style>
