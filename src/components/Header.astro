---
const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/writing', label: 'Writing' },
  { href: '/about', label: 'About' },
];

const current = Astro.url.pathname;
---

<header class="header">
  <a href="/" class="brand">
    <span class="status-dot" aria-hidden="true"></span>
    <span>Jaxon Oliver Doelling</span>
  </a>
  <nav class="nav">
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={['nav-link', { active: current.startsWith(link.href) }]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .status-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #22c55e;
    flex-shrink: 0;
  }

  .status-dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 999px;
    background: #22c55e;
    opacity: 0.5;
    animation: status-pulse 2s ease-out infinite;
  }

  @keyframes status-pulse {
    0% {
      transform: scale(0.6);
      opacity: 0.5;
    }
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  .nav {
    display: flex;
    gap: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .nav-link {
    color: var(--color-text-secondary);
    transition: color 0.15s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .header {
      padding: 1rem 1.25rem;
    }
    .nav {
      gap: 1rem;
    }
  }
</style>
