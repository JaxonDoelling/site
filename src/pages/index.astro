---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhoneOutline from '../components/icons/PhoneOutline.astro';
import LaptopOutline from '../components/icons/LaptopOutline.astro';
import KatanaOutline from '../components/icons/KatanaOutline.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Home">
  <section class="section hero">
    <h1>Wake up with determination.<br />Go to sleep with satisfaction.</h1>
    <p class="prose">
      I build software and write about what I learn along the way. This is
      where I keep both.
    </p>
    <div class="hero-links">
      <a href="/projects" class="btn btn-primary">See projects</a>
      <a href="/writing" class="btn">Read writing</a>
    </div>
  </section>

  {
    projects.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Projects</h2>
          <a href="/projects" class="link meta">
            View all
          </a>
        </div>
        <div class="card-grid">
          {projects.map((project) => (
            <a href={`/projects/${project.slug}`} class="card">
              <h3>{project.data.title}</h3>
              <p>{project.data.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Writing</h2>
          <a href="/writing" class="link meta">
            View all
          </a>
        </div>
        <div class="card-grid">
          {posts.map((post) => (
            <a href={`/writing/${post.slug}`} class="card">
              <h3>{post.data.title}</h3>
              <p>{post.data.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="section">
    <h2>Gear</h2>
    <div class="gear-grid">
      <div class="gear-item">
        <h3>Samsung Galaxy S24 Ultra</h3>
        <div class="gear-icon"><PhoneOutline /></div>
      </div>
      <div class="gear-item">
        <h3>Lenovo Legion Pro 5i</h3>
        <div class="gear-icon"><LaptopOutline /></div>
      </div>
      <div class="gear-item">
        <h3>Katana</h3>
        <div class="gear-icon"><KatanaOutline /></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .card-grid {
    gap: 1rem;
  }

  .card-grid .card {
    box-shadow: 0 0 20px rgba(47, 143, 255, 0.05);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .card-grid .card:hover {
    border-color: var(--color-accent);
    box-shadow:
      0 0 24px rgba(47, 143, 255, 0.25),
      0 0 4px rgba(47, 143, 255, 0.4);
  }

  .gear-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 1.5rem;
    text-align: center;
  }

  .gear-item h3 {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  .gear-icon {
    width: 100%;
    max-width: 140px;
    height: 180px;
    margin: 0 auto;
    color: var(--color-text-secondary);
  }

  .gear-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 640px) {
    .gear-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
