---
import BaseLayout from '../layouts/BaseLayout.astro';
import OctopusMark from '../components/OctopusMark.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Home">
  <section class="section hero">
    <OctopusMark size={40} class="hero-mark" />
    <h1>Jaxon Oliver Doelling</h1>
    <p class="prose">
      I build software and write about what I learn along the way. This is
      where I keep both.
    </p>
    <div class="hero-links">
      <a href="/projects" class="btn btn-primary">See projects</a>
      <a href="/writing" class="btn">Read writing</a>
    </div>
  </section>

  {
    projects.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Projects</h2>
          <a href="/projects" class="link meta">
            View all
          </a>
        </div>
        <div class="card-grid">
          {projects.map((project) => (
            <a href={`/projects/${project.slug}`} class="card">
              <h3>{project.data.title}</h3>
              <p>{project.data.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Writing</h2>
          <a href="/writing" class="link meta">
            View all
          </a>
        </div>
        <div class="card-grid">
          {posts.map((post) => (
            <a href={`/writing/${post.slug}`} class="card">
              <h3>{post.data.title}</h3>
              <p>{post.data.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero-mark {
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .hero-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .card-grid {
    gap: 1rem;
  }
</style>
