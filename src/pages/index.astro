---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardSlider from '../components/CardSlider.astro';
import PhoneOutline from '../components/icons/PhoneOutline.astro';
import LaptopOutline from '../components/icons/LaptopOutline.astro';
import KatanaOutline from '../components/icons/KatanaOutline.astro';
import M4A1Outline from '../components/icons/M4A1Outline.astro';
import BackpackOutline from '../components/icons/BackpackOutline.astro';
import CasioWatchOutline from '../components/icons/CasioWatchOutline.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const projectItems = projects.map((project) => ({
  href: `/projects/${project.slug}`,
  title: project.data.title,
  summary: project.data.summary,
}));

const postItems = posts.map((post) => ({
  href: `/writing/${post.slug}`,
  title: post.data.title,
  summary: post.data.summary,
}));
---

<BaseLayout title="Home">
  <section class="section">
    <h2>By the numbers</h2>
    <div class="metrics-grid">
      <div class="metric-card">
        <p class="metric-value">$10.8T</p>
        <p class="metric-label">Projected global cost of cybercrime, 2026</p>
        <p class="metric-source meta">Cybersecurity Ventures</p>
      </div>
      <div class="metric-card">
        <p class="metric-value">$618B</p>
        <p class="metric-label">Global AI market size, 2026</p>
        <p class="metric-source meta">Statista</p>
      </div>
      <div class="metric-card">
        <p class="metric-value">+32%</p>
        <p class="metric-label">Revenue growth for top design-led companies vs. peers</p>
        <p class="metric-source meta">McKinsey Design Index</p>
      </div>
    </div>
  </section>

  {
    projectItems.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Projects</h2>
          <a href="/projects" class="link meta">
            View all
          </a>
        </div>
        <CardSlider items={projectItems} />
      </section>
    )
  }

  {
    postItems.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Writing</h2>
          <a href="/writing" class="link meta">
            View all
          </a>
        </div>
        <CardSlider items={postItems} />
      </section>
    )
  }

  <section class="section">
    <h2>Gear</h2>
    <div class="gear-grid">
      <div class="gear-item">
        <h3>Samsung Galaxy S24 Ultra</h3>
        <div class="gear-icon"><PhoneOutline /></div>
      </div>
      <div class="gear-item">
        <h3>Lenovo Legion Pro 5i</h3>
        <div class="gear-icon"><LaptopOutline /></div>
      </div>
      <div class="gear-item">
        <h3>Katana</h3>
        <div class="gear-icon"><KatanaOutline /></div>
      </div>
      <div class="gear-item">
        <h3>M4A1</h3>
        <div class="gear-icon"><M4A1Outline /></div>
      </div>
      <div class="gear-item">
        <h3>Tactical Backpack</h3>
        <div class="gear-icon"><BackpackOutline /></div>
      </div>
      <div class="gear-item">
        <h3>Casio Watch</h3>
        <div class="gear-icon"><CasioWatchOutline /></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .metric-card {
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 2rem 1.5rem;
    background: var(--color-bg-elevated);
    box-shadow: 0 0 20px rgba(47, 143, 255, 0.05);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .metric-card:hover {
    border-color: var(--color-accent);
    box-shadow:
      0 0 24px rgba(47, 143, 255, 0.25),
      0 0 4px rgba(47, 143, 255, 0.4);
  }

  .metric-value {
    font-family: var(--font-mono);
    font-size: 2.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .metric-label {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
  }

  .metric-source {
    color: var(--color-text-tertiary);
  }

  @media (max-width: 640px) {
    .metrics-grid {
      grid-template-columns: 1fr;
    }
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .gear-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 1.5rem;
    text-align: center;
  }

  .gear-item h3 {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  .gear-icon {
    width: 100%;
    max-width: 140px;
    height: 180px;
    margin: 0 auto;
    color: var(--color-text-secondary);
  }

  .gear-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 640px) {
    .gear-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
