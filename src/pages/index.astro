---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardSlider from '../components/CardSlider.astro';
import PhoneOutline from '../components/icons/PhoneOutline.astro';
import LaptopOutline from '../components/icons/LaptopOutline.astro';
import KatanaOutline from '../components/icons/KatanaOutline.astro';
import M4A1Outline from '../components/icons/M4A1Outline.astro';
import BackpackOutline from '../components/icons/BackpackOutline.astro';
import CasioWatchOutline from '../components/icons/CasioWatchOutline.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const projectItems = projects.map((project) => ({
  href: `/projects/${project.slug}`,
  title: project.data.title,
  summary: project.data.summary,
}));

const postItems = posts.map((post) => ({
  href: `/writing/${post.slug}`,
  title: post.data.title,
  summary: post.data.summary,
}));
---

<BaseLayout title="Home">
  <section class="section hero">
    <h1>
      I build software and write about what I learn along the way. This is
      where I keep both.
    </h1>
    <div class="hero-links">
      <a href="/projects" class="btn btn-primary">See projects</a>
      <a href="/writing" class="btn">Read writing</a>
    </div>
  </section>

  {
    projectItems.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Projects</h2>
          <a href="/projects" class="link meta">
            View all
          </a>
        </div>
        <CardSlider items={projectItems} />
      </section>
    )
  }

  {
    postItems.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Writing</h2>
          <a href="/writing" class="link meta">
            View all
          </a>
        </div>
        <CardSlider items={postItems} />
      </section>
    )
  }

  <section class="section">
    <h2>Gear</h2>
    <div class="gear-grid">
      <div class="gear-item">
        <h3>Samsung Galaxy S24 Ultra</h3>
        <div class="gear-icon"><PhoneOutline /></div>
      </div>
      <div class="gear-item">
        <h3>Lenovo Legion Pro 5i</h3>
        <div class="gear-icon"><LaptopOutline /></div>
      </div>
      <div class="gear-item">
        <h3>Katana</h3>
        <div class="gear-icon"><KatanaOutline /></div>
      </div>
      <div class="gear-item">
        <h3>M4A1</h3>
        <div class="gear-icon"><M4A1Outline /></div>
      </div>
      <div class="gear-item">
        <h3>Tactical Backpack</h3>
        <div class="gear-icon"><BackpackOutline /></div>
      </div>
      <div class="gear-item">
        <h3>Casio Watch</h3>
        <div class="gear-icon"><CasioWatchOutline /></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: 4.5rem;
    padding-bottom: 4.5rem;
  }

  .hero h1 {
    max-width: 34ch;
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: normal;
    color: var(--color-text);
  }

  .hero-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .gear-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 1.5rem;
    text-align: center;
  }

  .gear-item h3 {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  .gear-icon {
    width: 100%;
    max-width: 140px;
    height: 180px;
    margin: 0 auto;
    color: var(--color-text-secondary);
  }

  .gear-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 640px) {
    .gear-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
